# --- Database (required for persistence) ---
# Use Vercel Postgres, Neon, Supabase, or any PostgreSQL connection string.
# Leave unset to run in demo mode (no persistence; seed data still shown).
DATABASE_URL="postgresql://user:password@host:5432/setu?schema=public"

# --- NextAuth ---
NEXTAUTH_SECRET="please-change-me-dev-secret-4f2a9c81b7d63e05"
# Only needed if you override the auto-detected host (usually leave unset on Vercel)
NEXTAUTH_URL="http://localhost:3000"

# --- Google OAuth (optional) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
# Leave unset to use the Demo Account login only.
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- OTP delivery (optional) ---
# When configured, SETU delivers the Aadhaar verification OTP over the channel.
# Leave all unset to run in demo mode (OTP is shown on screen instead).
#
# Twilio SMS:
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+15551234567"
#
# SMTP email (send OTP by email when SMS is not configured):
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="otp@setu.gov.in"
SMTP_PASS="your-smtp-password"
SMTP_FROM="otp@setu.gov.in"
